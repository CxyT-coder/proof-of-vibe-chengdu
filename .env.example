# Both endpoints must be Solana Devnet; the app is fixed to Devnet.
# HTTP RPC must allow your website origin via CORS; WS must allow it too.
# NEXT_PUBLIC_* values are exposed in the browser. Never put secrets here.
# Use a domain-restricted public credential or a server proxy for paid RPC.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com
